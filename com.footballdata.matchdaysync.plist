<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.footballdata.matchdaysync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicknav98/Code/football_data_project/.venv/bin/python</string>
        <string>/Users/nicknav98/Code/football_data_project/sync_matchday_stats.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nicknav98/Code/football_data_project</string>

    <!-- Runs every 3 hours; the script itself is a no-op unless a new
         matchday needs syncing or recent fixture stats need rechecking. -->
    <key>StartInterval</key>
    <integer>10800</integer>

    <key>StandardOutPath</key>
    <string>/Users/nicknav98/Code/football_data_project/logs/matchdaysync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicknav98/Code/football_data_project/logs/matchdaysync.err.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
